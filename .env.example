# BingPoints 配置示例
#
# 用法：把本文件复制成 .env（同目录），按需填写。
# .env 已在 .gitignore 中，凭据不会被提交。
#
# 不填 SMTP_HOST / SMTP_TO 时，失败推送功能自动关闭（不报错）。
# 只有运行失败（退出码非 0）才会发邮件；成功不打扰。

# ---- 失败推送（邮件）----
# SMTP 服务器地址，常见值：
#   QQ 邮箱      smtp.qq.com
#   163 邮箱     smtp.163.com
#   Outlook      smtp.office365.com
#   Gmail        smtp.gmail.com
SMTP_HOST=

# 端口：465 为 SSL（默认），587 为 STARTTLS
SMTP_PORT=465

# 登录用户名（通常是你的邮箱地址）
SMTP_USER=

# 授权码 / 应用专用密码。注意：多数邮箱不接受登录密码，需要在邮箱设置里
# 生成"授权码"。QQ 邮箱：设置 → 账户 → 开启 SMTP 服务 → 生成授权码。
SMTP_PASSWORD=

# 收件人，多个用逗号或分号分隔
SMTP_TO=

# 发件人地址，留空则回退到 SMTP_USER
SMTP_FROM=

# 是否用 SSL：1=是（465 端口用），0=否（587 端口走 STARTTLS）
SMTP_SSL=1

# ---- Browser / client tasks ----
# Default: project-owned dedicated Edge profile (first run requires manual Microsoft login).
# Advanced: explicitly reuse the real local Edge User Data; close all Edge windows first.
# Both shell-style and percent-style variables are expanded.
# Unknown variables and relative paths are rejected at startup.
# Example (forward slashes avoid escaping ambiguity):
# BING_REWARDS_EDGE_USER_DATA_DIR=${LOCALAPPDATA}/Microsoft/Edge/User Data
# Android emulator Bing App check-in (enabled by default; skips if no device)
BING_REWARDS_MOBILE_CLIENT=1
# BING_REWARDS_ADB=C:\Android\sdk\platform-tools\adb.exe
# Rewards desktop WebView exclusive task (enabled; advances at most one per run)
BING_REWARDS_DESKTOP_APP=1
